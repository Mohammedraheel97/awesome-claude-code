{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t: shop: shop.name }}</title>
    <meta name="robots" content="noindex">
    {% render 'css-variables', dir: 'ltr' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="color-scheme-1">
    <main class="giftcard page-width">
      <h1 class="page-heading">{{ shop.name }}</h1>
      <div class="giftcard-card color-scheme-3">
        <p class="eyebrow">{{ 'gift_card.title' | t: shop: shop.name }}</p>
        <p class="giftcard-amount">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial_money = gift_card.initial_value | money -%}
          <p>{{ 'gift_card.initial' | t: value: initial_money }}</p>
        {%- endif -%}
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="badge badge--soldout">{{ 'gift_card.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%Y-%m-%d' -%}
          <p>{{ 'gift_card.expires' | t: date: expires_on }}</p>
        {%- endif -%}
        <p class="giftcard-code" dir="ltr">{{ gift_card.code | format_code }}</p>
      </div>
      <div class="btn-row center-row">
        <a class="btn btn--lg" href="{{ shop.url }}">{{ 'gift_card.shop' | t }}</a>
        <button class="btn btn--lg btn--outline" type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
      </div>
      {%- if gift_card.pass_url -%}<p class="center-row"><a href="{{ gift_card.pass_url }}">{{ 'gift_card.apple_wallet' | t }}</a></p>{%- endif -%}
    </main>
  </body>
</html>

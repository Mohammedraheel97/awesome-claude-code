{%- liquid
  assign blocks_count = section.blocks.size
-%}
{%- if blocks_count > 0 -%}
<div class="announce color-{{ section.settings.color_scheme }}" data-announce data-interval="{{ section.settings.interval | times: 1000 }}" {{ section.shopify_attributes }}>
  <div class="page-width announce-inner">
    <div class="announce-slides">
      {%- for block in section.blocks -%}
        <p class="announce-slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          <span>{{ block.settings.text | escape }}</span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- if block.settings.code != blank -%}
            <button class="code-pill" type="button" data-copy="{{ block.settings.code | escape }}">{{ block.settings.code | escape }}</button>
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    {%- if section.settings.phone != blank -%}
      <a class="announce-phone" href="tel:{{ section.settings.phone | remove: ' ' }}" dir="ltr">{{ section.settings.phone }}</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "range", "id": "interval", "label": "Seconds between messages", "min": 3, "max": 12, "step": 1, "default": 5, "info": "Used when there is more than one message" },
    { "type": "text", "id": "phone", "label": "Phone number (shown on desktop)", "default": "+965 9228 6230" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "15% off orders of 6 KWD and up — use code" },
        { "type": "text", "id": "code", "label": "Discount code (click to copy)", "default": "15OFF" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Announcement bar", "blocks": [ { "type": "announcement" } ] } ]
}
{% endschema %}

<section class="section color-{{ section.settings.color_scheme }}" style="--pt: 56px; --pb: 72px">
  <div class="page-width auth">
    <h1 class="page-heading">{{ 'customer.activate_heading' | t }}</h1>
    <p class="muted">{{ 'customer.activate_text' | t }}</p>
    {%- form 'activate_customer_password', class: 'form-stack' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="field"><span>{{ 'customer.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="field"><span>{{ 'customer.password_confirm' | t }}</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button class="btn btn--lg btn--block" type="submit">{{ 'customer.activate' | t }}</button>
      <button class="btn btn--outline btn--block" type="submit" name="decline">{{ 'customer.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Activate account", "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" } ] }
{% endschema %}

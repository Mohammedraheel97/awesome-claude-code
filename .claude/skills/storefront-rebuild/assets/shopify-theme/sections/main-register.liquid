<section class="section color-{{ section.settings.color_scheme }}" style="--pt: 56px; --pb: 72px">
  <div class="page-width auth">
    <h1 class="page-heading">{{ 'customer.create_account' | t }}</h1>
    {%- form 'create_customer', class: 'form-stack' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="field"><span>{{ 'customer.first_name' | t }}</span><input type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}"></label>
      <label class="field"><span>{{ 'customer.last_name' | t }}</span><input type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}"></label>
      <label class="field"><span>{{ 'customer.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" required value="{{ form.email }}"></label>
      <label class="field"><span>{{ 'customer.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <button class="btn btn--lg btn--block" type="submit">{{ 'customer.create' | t }}</button>
      <a class="link-plain" href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Register", "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" } ] }
{% endschema %}

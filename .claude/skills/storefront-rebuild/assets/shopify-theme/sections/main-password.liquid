<section class="password color-{{ section.settings.color_scheme }}">
  <div class="password-card">
    {%- assign logo = section.settings.logo | default: settings.logo -%}
    {%- if logo != blank -%}{{ logo | image_url: width: 300 | image_tag: class: 'password-logo', alt: shop.name }}{%- else -%}<h1>{{ shop.name }}</h1>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h-medium">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <div class="input-row">
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.email' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
        <button class="btn" type="submit">{{ 'password.notify' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
    <details class="password-login">
      <summary>{{ 'password.enter_with_password' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="input-row">
          <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
          <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
    {% render 'social-icons', class: 'password-social' %}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "نفتتح قريبًا" }
  ]
}
{% endschema %}

# Copy to .env.local for local development. Never commit real values.

# --- Shopify Storefront API (optional) -------------------------------------
# When BOTH of these are set, the storefront uses live Shopify data and
# Shopify-hosted checkout. When unset, the sample catalog is shown.
# Use the PUBLIC Storefront API access token (not an Admin API token).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional: pin a Storefront API version.
# SHOPIFY_API_VERSION=2025-07

# --- Site -------------------------------------------------------------------
# Canonical site URL used for sitemap, canonical links and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the contact page and footer when set.
CONTACT_EMAIL=
CONTACT_PHONE=

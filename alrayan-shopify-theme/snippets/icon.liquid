{%- comment -%}
  Inline SVG icons. Accepts: name {String}, size {Number} (optional, default 22)
{%- endcomment -%}
{%- assign s = size | default: 22 -%}
<svg class="icon icon-{{ name }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true" focusable="false">

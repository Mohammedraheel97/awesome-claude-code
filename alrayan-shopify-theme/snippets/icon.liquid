    {%- when 'facebook' -%}<path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4A21 21 0 0 0 14.3 4c-2.3 0-3.8 1.4-3.8 4v2.5H8v3h2.5V21h3Z" fill="currentColor"/>
    {%- when 'x' -%}<path d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z" fill="currentColor"/>
    {%- when 'snapchat' -%}<path d="M12 3c3 0 5 2.2 5 5.2v2.2l1.6-.5c.6-.2 1.1.6.5 1l-2 1.1c.6 1.7 1.9 3 3.6 3.5.5.2.4.9-.1 1-1 .3-1.7.4-2 .9-.2.4-.3 1-.9.9-1-.2-2-.1-3 .7-.8.6-1.6 1-2.7 1s-1.9-.4-2.7-1c-1-.8-2-.9-3-.7-.6.1-.7-.5-.9-.9-.3-.5-1-.6-2-.9-.5-.1-.6-.8-.1-1 1.7-.5 3-1.8 3.6-3.5l-2-1.1c-.6-.4-.1-1.2.5-1l1.6.5V8.2C7 5.2 9 3 12 3Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'youtube' -%}<path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z" fill="currentColor"/>
    {%- else -%}<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7"/>
  {%- endcase -%}
</svg>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
  assign crumb_collection = collection | default: product.collections.first
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' '
-%}
<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px" data-product data-section-id="{{ section.id }}" data-url="{{ product.url }}" data-handle="{{ product.handle }}">
  {%- if section.settings.show_breadcrumbs -%}
    <nav class="page-width crumbs crumbs--dark" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
      {%- if crumb_collection -%}<a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a><span aria-hidden="true">/</span>{%- endif -%}
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>
  {%- endif -%}

  <div class="page-width pdp pdp--{{ section.settings.media_size }}">
    <div class="pdp-media{% if section.settings.sticky_media %} is-sticky{% endif %}">
      <div class="pdp-stage{% if section.settings.zoom %} zoom{% endif %}" data-zoom>
        {%- for media in product.media -%}
          <div class="pdp-slide{% if media.id == featured.id %} is-active{% endif %}" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if media.id == featured.id -%}
                  {{ media | image_url: width: 1400 | image_tag: widths: '500,700,1000,1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title, fetchpriority: 'high' }}
                {%- else -%}
                  {{ media | image_url: width: 1400 | image_tag: widths: '500,700,1000,1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title, loading: 'lazy' }}
                {%- endif -%}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, image_size: '1100x' }}
              {%- else -%}
                {{ media | media_tag: image_size: '1100x' }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="pdp-slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp-thumbs" role="list">
          {%- for media in product.media -%}
            <button type="button" role="listitem" class="pdp-thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ 'products.media' | t: n: forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'collection_link' -%}
            {%- if crumb_collection -%}<a class="eyebrow-link" href="{{ crumb_collection.url }}" {{ block.shopify_attributes }}>{{ crumb_collection.title | escape }}</a>{%- endif -%}
          {%- when 'vendor' -%}
            <p class="pdp-vendor" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>
          {%- when 'title' -%}
            <h1 class="pdp-title h-{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
          {%- when 'price' -%}
            <div class="pdp-price" data-price-wrap {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, large: true %}
            </div>
            {%- if block.settings.show_tax_note and cart.taxes_included -%}<p class="pdp-note">{{ 'products.tax_included' | t }}</p>{%- endif -%}
          {%- when 'inventory' -%}
            <p class="stock{% if current_variant.available %} is-in{% else %} is-out{% endif %}" data-stock data-in="{{ 'products.in_stock' | t }}" data-out="{{ 'products.sold_out' | t }}" {{ block.shopify_attributes }}>
              {%- if current_variant.available -%}{{ 'products.in_stock' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
            </p>
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign opt_index = forloop.index0 -%}
                  {%- if block.settings.style == 'dropdown' -%}
                    <label class="opt-select"><span>{{ option.name | escape }}</span>
                      <select name="options[{{ option.name | escape }}]" data-option-index="{{ opt_index }}">
                        {%- for value in option.values -%}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>{%- endfor -%}
                      </select>
                    </label>
                  {%- else -%}
                    <fieldset class="opt">
                      <legend>{{ option.name | escape }}</legend>
                      <div class="opt-vals">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign hint = ''
                            if block.settings.show_prices and product.options.size == 1
                              assign match = product.variants | where: 'option1', value | first
                              if match
                                assign hint = match.price | money
                              endif
                            endif
                          -%}
                          <label>
                            <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-index="{{ opt_index }}"{% if option.selected_value == value %} checked{% endif %}>
                            <span>{{ value | escape }}{% if hint != '' %}<small>{{ hint }}</small>{% endif %}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endif -%}
                {%- endfor -%}
                <script type="application/json" data-variants>
                  [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"title":{{ v.title | json }},"price":{{ v.price | money | json }},"compare":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},"sku":{{ v.sku | json }},"media":{{ v.featured_media.id | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
                </script>
              </div>
            {%- endunless -%}
          {%- when 'quantity' -%}
            <div class="pdp-qty" {{ block.shopify_attributes }}>
              <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
              <div class="qty qty--big" data-qty>
                <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', name: 'minus', size: 18 %}</button>
                <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" form="{{ form_id }}">
                <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">{% render 'icon', name: 'plus', size: 18 %}</button>
              </div>
            </div>
          {%- when 'buy_buttons' -%}
            <div class="pdp-buy" data-buy {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <button class="btn btn--lg btn--block" type="submit" name="add" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
                  {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
              {%- endform -%}
              <p class="form-error" data-form-error hidden></p>
            </div>
          {%- when 'whatsapp' -%}
            {%- if wa_number != blank -%}
              {%- capture wa_text -%}{{ block.settings.message }} {{ product.title }}{%- endcapture -%}
              <a class="btn btn--lg btn--block btn--whatsapp" href="https://wa.me/{{ wa_number }}?text={{ wa_text | append: ' ' | append: request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener" data-whatsapp-product data-number="{{ wa_number }}" data-message="{{ block.settings.message | escape }}" data-title="{{ product.title | escape }}" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'whatsapp', size: 20 %} {{ block.settings.label | escape }}
              </a>
            {%- endif -%}
          {%- when 'perks' -%}
            {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
            <ul class="pdp-perks" {{ block.shopify_attributes }}>
              {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{% render 'icon', name: 'check', size: 16 %}<span>{{ l | escape }}</span></li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              {%- if block.settings.collapsible -%}
                <details class="acc" open {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ product.description }}</div></details>
              {%- else -%}
                <div class="rte pdp-desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}
            {%- endif -%}
          {%- when 'collapsible' -%}
            <details class="acc"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
            </details>
          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'sku' -%}
            <p class="pdp-sku" data-sku {{ block.shopify_attributes }}{% if current_variant.sku == blank %} hidden{% endif %}>{{ 'products.sku' | t }}: <span>{{ current_variant.sku }}</span></p>
          {%- when 'share' -%}
            <div class="pdp-share" {{ block.shopify_attributes }}>
              <span>{{ 'products.share' | t }}:</span>
              <a href="https://wa.me/?text={{ product.title | append: ' ' | append: request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">Facebook</a>
              <button type="button" data-copy="{{ request.origin }}{{ product.url }}" data-copy-message="{{ 'products.link_copied' | t }}">{{ 'products.copy_link' | t }}</button>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="sticky-buy color-{{ section.settings.color_scheme }}" data-sticky-buy hidden>
      {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
      <div><b>{{ product.title | escape }}</b><span data-sticky-price>{{ current_variant.price | money }}</span></div>
      <button class="btn" type="submit" name="add" form="{{ form_id }}" data-add-button{% unless current_variant.available %} disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
    </div>
  {%- endif -%}
  {{ product | structured_data }}
</section>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "select", "id": "media_size", "label": "Media width", "default": "large", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "checkbox", "id": "sticky_media", "label": "Keep media visible while scrolling (desktop)", "default": true },
    { "type": "checkbox", "id": "zoom", "label": "Zoom image on hover", "default": true },
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add-to-cart bar on mobile", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "collection_link", "name": "Collection link", "limit": 1, "settings": [] },
    { "type": "vendor", "name": "Vendor", "limit": 1, "settings": [] },
    { "type": "title", "name": "Title", "limit": 1, "settings": [ { "type": "select", "id": "size", "label": "Size", "default": "large", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] } ] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [ { "type": "checkbox", "id": "show_tax_note", "label": "Show \"tax included\" note", "default": false } ] },
    { "type": "inventory", "name": "Stock status", "limit": 1, "settings": [] },
    {
      "type": "variant_picker", "name": "Variant picker", "limit": 1,
      "settings": [
        { "type": "select", "id": "style", "label": "Style", "default": "buttons", "options": [ { "value": "buttons", "label": "Buttons" }, { "value": "dropdown", "label": "Dropdown" } ] },
        { "type": "checkbox", "id": "show_prices", "label": "Show price under each option", "info": "For products with one option, e.g. weight", "default": true }
      ]
    },
    { "type": "quantity", "name": "Quantity", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [ { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true } ] },
    {
      "type": "whatsapp", "name": "WhatsApp order", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "اطلب مباشرة عبر واتساب" },
        { "type": "text", "id": "message", "label": "Message start", "default": "مرحبًا، أرغب بطلب:" }
      ]
    },
    { "type": "perks", "name": "Perks list", "limit": 1, "settings": [ { "type": "textarea", "id": "lines", "label": "One perk per line", "default": "توصيل لجميع مناطق الكويت أو استلام من الفرع\nدفع آمن: كي نت، فيزا / ماستر أو نقدًا\nخصم 15% للطلبات من 6 د.ك بالكود 15OFF" } ] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [ { "type": "checkbox", "id": "collapsible", "label": "Show in a collapsible tab", "default": true }, { "type": "text", "id": "heading", "label": "Tab heading", "default": "تفاصيل المنتج" } ] },
    {
      "type": "collapsible", "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "التوصيل والدفع" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>نوصّل الطلبات داخل الكويت، ويمكنك أيضًا الاستلام من فرعنا في حولي.</p>" },
        { "type": "page", "id": "page", "label": "Content from a page" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>نص إضافي</p>" } ] },
    { "type": "sku", "name": "SKU", "limit": 1, "settings": [] },
    { "type": "share", "name": "Share", "limit": 1, "settings": [] }
  ]
}
{% endschema %}

<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --cols: {{ section.blocks.size | at_most: section.settings.max_columns }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, align: 'start', size: 'medium' %}
    <div class="promo-grid promo--{{ section.settings.height }}">
      {%- for block in section.blocks -%}
        <a class="promo-card promo-card--{{ block.settings.align }}" href="{{ block.settings.link | default: routes.collections_url }}" style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.image.alt }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <span class="promo-copy">
            {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
            {%- if block.settings.heading != blank -%}<strong>{{ block.settings.heading | escape }}</strong>{%- endif -%}
            {%- if block.settings.button_label != blank -%}<span class="btn btn--light">{{ block.settings.button_label | escape }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banners",
  "class": "section-promo",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "max_columns", "label": "Banners per row on desktop", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "select", "id": "height", "label": "Banner height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "banner", "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "تشكيلة جديدة" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "دراجيه الفواكه والشوكولاتة" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "تسوق الآن" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "align", "label": "Text position", "default": "bottom", "options": [ { "value": "bottom", "label": "Bottom" }, { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" } ] },
        { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 70 }
      ]
    }
  ],
  "presets": [ { "name": "Promo banners", "blocks": [ { "type": "banner" }, { "type": "banner", "settings": { "eyebrow": "من مطحنتنا", "heading": "بهارات وأعشاب مطحونة بعناية" } } ] } ]
}
{% endschema %}

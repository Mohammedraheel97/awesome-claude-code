{%- liquid
  assign heading = 'not_found.title' | t
  if section.settings.heading != blank
    assign heading = section.settings.heading
  endif
-%}
<section class="section color-{{ section.settings.color_scheme }}" style="--pt: 80px; --pb: 96px">
  <div class="page-width notfound">
    <p class="nf-code">404</p>
    <h1 class="h-large">{{ heading | escape }}</h1>
    <p class="muted">{{ 'not_found.text' | t }}</p>
    <form class="search-form search-form--page" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      {% render 'icon', name: 'search', size: 20 %}
      <input type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <button class="btn" type="submit">{{ 'general.search' | t }}</button>
    </form>
    <div class="btn-row center-row">
      <a class="btn btn--lg" href="{{ routes.root_url }}">{{ 'not_found.back' | t }}</a>
      <a class="btn btn--lg btn--outline" href="{{ routes.collections_url }}">{{ 'collections.all_collections' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "class": "section-404",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "الصفحة غير موجودة" }
  ]
}
{% endschema %}

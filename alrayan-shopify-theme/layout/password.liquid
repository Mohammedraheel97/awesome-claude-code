<!doctype html>
{%- liquid
  assign lang2 = request.locale.iso_code | slice: 0, 2
  assign dir = 'ltr'
  if settings.text_direction == 'rtl'
    assign dir = 'rtl'
  elsif settings.text_direction == 'auto'
    case lang2
      when 'ar', 'he', 'fa', 'ur'
        assign dir = 'rtl'
    endcase
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
    {% render 'css-variables', dir: dir %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>

# Copy to .env for local development. `shopify app dev` provides the SHOPIFY_* variables.

# Prisma database. For SQLite the path is relative to prisma/.
DATABASE_URL="file:dev.sqlite"

# Background worker (optional)
# OOS_SORTER_SCHEDULER=off        # turn off the in-process scheduler (then call POST /api/worker yourself)
# OOS_SORTER_TICK_SECONDS=60      # how often the in-process scheduler runs
# CRON_SECRET=change-me           # enables POST /api/worker with "Authorization: Bearer <CRON_SECRET>"

{%- comment -%}
  ARABIC VERSION — generated by tools/make_arabic.py from packing-slip.liquid.
  Paste into: Translate & Adapt > Arabic > Notifications > (this template) > Arabic field.
  Do NOT use Auto-translate on this template; it would translate the Liquid code.
{%- endcomment -%}
{%- comment -%}
  89 SHIRT SHOP — Packing slip
  Paste into: Shopify admin > Settings > Shipping and delivery > Packing slips > Edit

  Brand palette (from theme "89shirts"): ink #0a0a0a · red #e10b17 · bone #f3f2ef
  Accent palette (theme badge colors): blue #2f6bff · pink #ff4f8b · purple #8b5cf6
    orange #ff6a00 · green #1fb85a · yellow #ffd400

  PRICES: Shopify's packing-slip variable list documents items, quantities and
  addresses only. Every price / discount / total block below is guarded and shows
  automatically when Shopify supplies the value, and hides cleanly when it doesn't.
{%- endcomment -%}
{%- liquid
  assign brand_logo = 'https://cdn.shopify.com/s/files/1/0785/2956/0650/files/89shirt-email-logo-white.png?v=1793723695'
  assign brand_qr = 'https://cdn.shopify.com/s/files/1/0785/2956/0650/files/89shirt-whatsapp-qr.png?v=1793724175'
  assign brand_whatsapp_display = '+965 6689 9260'
  assign brand_instagram = '@89shirt'
  assign chip_colors = '#2f6bff,#ff4f8b,#8b5cf6,#ff6a00,#1fb85a' | split: ','

  assign is_pickup = false
  if delivery_method.type == 'pick-up'
    assign is_pickup = true
  endif

  # Counters (always available)
  assign line_count = 0
  assign units_in_box = 0
  assign units_in_order = 0
  for line_item in line_items_in_shipment
    assign line_count = line_count | plus: 1
    assign units_in_box = units_in_box | plus: line_item.shipping_quantity
    assign units_in_order = units_in_order | plus: line_item.quantity
  endfor

  # Price detection (only if Shopify exposes prices on this document)
  assign show_prices = false
  assign box_value = 0
  assign box_saved = 0
  for line_item in line_items_in_shipment
    assign unit_price = line_item.final_price | default: line_item.price
    if unit_price != nil
      assign show_prices = true
      assign line_box_value = unit_price | times: line_item.shipping_quantity
      assign box_value = box_value | plus: line_box_value
      if line_item.original_price != nil and line_item.original_price > unit_price
        assign line_box_saved = line_item.original_price | minus: unit_price | times: line_item.shipping_quantity
        assign box_saved = box_saved | plus: line_box_saved
      endif
    endif
  endfor

  assign show_totals = false
  if order.total_price != nil
    assign show_totals = true
  endif

  case order.financial_status
    when 'paid'
      assign status_ar = 'مدفوع'
    when 'pending'
      assign status_ar = 'بانتظار الدفع'
    when 'authorized'
      assign status_ar = 'مُصرّح'
    when 'partially_paid'
      assign status_ar = 'مدفوع جزئياً'
    when 'refunded'
      assign status_ar = 'مسترد'
    when 'partially_refunded'
      assign status_ar = 'مسترد جزئياً'
    when 'voided'
      assign status_ar = 'ملغى'
    else
      assign status_ar = order.financial_status
  endcase
  assign collect_on_delivery = false
  if order.financial_status == 'pending' or order.financial_status == 'authorized' or order.financial_status == 'partially_paid'
    assign collect_on_delivery = true
    assign amount_to_collect = order.total_outstanding | default: order.total_price
  endif
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;900&family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">

<div class="slip" dir="rtl" lang="ar">

  {%- comment -%} ================= HEADER ================= {%- endcomment -%}
  <div class="hdr">
    <div class="hdr__brand">
      <img src="{{ brand_logo }}" alt="{{ shop.name }}" class="hdr__logo">
      <div>
        <p class="eyebrow eyebrow--red">قائمة التعبئة</p>
        <p class="hdr__title">إطلالتك وصلت<span class="red">.</span></p>
      </div>
    </div>
    <div class="hdr__meta">
      <p class="hdr__order">{{ order.name }}</p>
      <p class="hdr__line">{{ order.created_at | date: format: "date" }}</p>
      {% if order.po_number != blank %}<p class="hdr__line">أمر شراء #{{ order.po_number }}</p>{% endif %}
    </div>
  </div>
  <div class="stripe">
    <span style="background:#e10b17"></span><span style="background:#ff6a00"></span><span style="background:#ffd400"></span><span style="background:#1fb85a"></span><span style="background:#2f6bff"></span><span style="background:#8b5cf6"></span><span style="background:#ff4f8b"></span>
  </div>

  {%- comment -%} ================= STAT TILES ================= {%- endcomment -%}
  <div class="stats">
    <div class="stat" style="--c:#2f6bff">
      <p class="stat__label">القطع في الصندوق</p>
      <p class="stat__value">{{ units_in_box }}</p>
      <p class="stat__sub">{{ line_count }} منتج</p>
    </div>
    <div class="stat" style="--c:{% if includes_all_line_items_in_order %}#1fb85a{% else %}#ff6a00{% endif %}">
      <p class="stat__label">الشحنة</p>
      <p class="stat__value stat__value--sm">{% if includes_all_line_items_in_order %}مكتملة{% else %}جزئية{% endif %}</p>
      <p class="stat__sub">{{ units_in_box }} من {{ units_in_order }} قطعة</p>
    </div>
    <div class="stat" style="--c:#8b5cf6">
      <p class="stat__label">التوصيل</p>
      <p class="stat__value stat__value--sm">
        {%- case delivery_method.type -%}
          {%- when 'pick-up' -%}استلام من المتجر
          {%- when 'local' -%}توصيل محلي
          {%- when 'none' -%}بدون شحن
          {%- else -%}شحن
        {%- endcase -%}
      </p>
      <p class="stat__sub">{% if delivery_method.instructions != blank %}يوجد تعليمات{% else %}عادي{% endif %}</p>
    </div>
    {% if show_totals %}
      <div class="stat stat--solid" style="--c:#e10b17">
        <p class="stat__label">إجمالي الطلب</p>
        <p class="stat__value stat__value--sm">{{ order.total_price | money }}</p>
        <p class="stat__sub">{% if order.total_discounts > 0 %}وفّرت {{ order.total_discounts | money }}{% else %}{{ status_ar }}{% endif %}</p>
      </div>
    {% elsif show_prices %}
      <div class="stat stat--solid" style="--c:#e10b17">
        <p class="stat__label">قيمة الصندوق</p>
        <p class="stat__value stat__value--sm">{{ box_value | money }}</p>
        <p class="stat__sub">{% if box_saved > 0 %}وفّرت {{ box_saved | money }}{% else %}هذه الشحنة{% endif %}</p>
      </div>
    {% else %}
      <div class="stat stat--solid" style="--c:#e10b17">
        <p class="stat__label">تاريخ التعبئة</p>
        <p class="stat__value stat__value--sm">{{ 'now' | date: "%d/%m" }}</p>
        <p class="stat__sub">{{ 'now' | date: "%Y" }}</p>
      </div>
    {% endif %}
  </div>

  {% if collect_on_delivery and show_totals %}
    <div class="cod">
      <div>
        <p class="eyebrow">التحصيل عند التوصيل</p>
        <p class="cod__text">حالة الدفع: {{ status_ar }} &mdash; يرجى تحصيل المبلغ من العميل.</p>
      </div>
      <p class="cod__amount">{{ amount_to_collect | money }}</p>
    </div>
  {% endif %}

  {%- comment -%} ================= ADDRESSES ================= {%- endcomment -%}
  <div class="addr">
    {% unless is_pickup %}
      <div class="addr__card" style="--c:#e10b17">
        <p class="eyebrow eyebrow--c">{% if delivery_method.instructions != blank %}التوصيل إلى{% else %}الشحن إلى{% endif %}</p>
        <p class="addr__body">
          {% if shipping_address != blank %}
            <strong>{{ shipping_address.name }}</strong>
            {% if shipping_address.company != blank %}<br>{{ shipping_address.company }}{% endif %}
            <br>{{ shipping_address.address1 }}
            {% if shipping_address.address2 != blank %}<br>{{ shipping_address.address2 }}{% endif %}
            {% if shipping_address.city_province_zip != blank %}<br>{{ shipping_address.city_province_zip }}{% elsif shipping_address.city != blank %}<br>{{ shipping_address.city }}{% endif %}
            <br>{{ shipping_address.country }}
            {% if shipping_address.phone != blank %}<br><span class="phone">&#9742; <span dir="ltr">{{ shipping_address.phone }}</span></span>{% endif %}
          {% else %}
            لا يوجد عنوان شحن
          {% endif %}
        </p>
      </div>
    {% endunless %}
    <div class="addr__card" style="--c:#2f6bff">
      <p class="eyebrow eyebrow--c">الفوترة إلى</p>
      <p class="addr__body">
        {% if billing_address != blank %}
          <strong>{{ billing_address.name }}</strong>
          {% if billing_address.company != blank %}<br>{{ billing_address.company }}{% endif %}
          <br>{{ billing_address.address1 }}
          {% if billing_address.address2 != blank %}<br>{{ billing_address.address2 }}{% endif %}
          {% if billing_address.city_province_zip != blank %}<br>{{ billing_address.city_province_zip }}{% elsif billing_address.city != blank %}<br>{{ billing_address.city }}{% endif %}
          <br>{{ billing_address.country }}
        {% else %}
          لا يوجد عنوان فوترة
        {% endif %}
      </p>
    </div>
    {% if customer.name != blank or customer.email != blank %}
      <div class="addr__card" style="--c:#8b5cf6">
        <p class="eyebrow eyebrow--c">العميل</p>
        <p class="addr__body">
          {% if customer.name != blank %}<strong>{{ customer.name }}</strong>{% endif %}
          {% if customer.email != blank %}<br>{{ customer.email }}{% endif %}
          {% if is_pickup %}<br><span class="tag" style="--c:#8b5cf6">استلام من المتجر</span>{% endif %}
        </p>
      </div>
    {% endif %}
  </div>

  {%- comment -%} ================= ITEMS ================= {%- endcomment -%}
  {% assign desired_image_size = 64 %}
  {% assign resolution_adjusted_size = desired_image_size | times: 300 | divided_by: 72 | ceil %}
  {% capture effective_image_dimensions %}{{ resolution_adjusted_size }}x{{ resolution_adjusted_size }}{% endcapture %}

  <div class="section-head">
    <p class="section-head__title">داخل الصندوق</p>
    <p class="section-head__count">{{ units_in_box }} قطعة</p>
  </div>

  <table class="items">
    <thead>
      <tr>
        <th class="items__check"></th>
        <th colspan="2">المنتج</th>
        {% if show_prices %}<th class="num">السعر</th>{% endif %}
        <th class="num">الكمية</th>
        {% if show_prices %}<th class="num">الإجمالي</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for line_item in line_items_in_shipment %}
        {%- liquid
          assign unit_price = line_item.final_price | default: line_item.price
          assign qty_complete = false
          if line_item.shipping_quantity == line_item.quantity
            assign qty_complete = true
          endif
        -%}
        <tr>
          <td class="items__check"><span class="box"></span></td>
          <td class="items__img">
            {% if line_item.image != blank %}
              {{ line_item.image | img_url: effective_image_dimensions | img_tag: '', 'items__photo' }}
            {% else %}
              <div class="items__photo items__photo--empty">89</div>
            {% endif %}
          </td>
          <td class="items__desc">
            <p class="items__title">{{ line_item.title }}</p>
            <div class="chips">
              {% if line_item.variant_title != blank %}
                {% assign variant_parts = line_item.variant_title | split: ' / ' %}
                {% for part in variant_parts %}
                  {% assign ci = forloop.index0 | modulo: 5 %}
                  <span class="chip" style="--c:{{ chip_colors[ci] }}">{{ part }}</span>
                {% endfor %}
              {% endif %}
              {% if line_item.sku != blank %}<span class="chip chip--ghost">رمز <span dir="ltr">{{ line_item.sku }}</span></span>{% endif %}
              {% if line_item.vendor != blank and line_item.vendor != shop.name %}<span class="chip chip--ghost">{{ line_item.vendor }}</span>{% endif %}
            </div>
            {% for group in line_item.groups %}
              <p class="items__meta">
                {% if group.deliverable? %}
                  <span class="tag" style="--c:#ff4f8b">إضافة</span> لـ {{ group.title }}
                {% else %}
                  <span class="tag" style="--c:#2f6bff">باقة</span> ضمن {{ group.title }}
                {% endif %}
              </p>
            {% endfor %}
            {% for property in line_item.properties %}
              {% assign property_first_char = property.first | slice: 0 %}
              {% if property.last != blank and property_first_char != '_' %}
                <p class="items__meta">
                  <span class="tag" style="--c:#8b5cf6">{{ property.first }}</span>
                  {% if property.last contains '/uploads/' %}
                    <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                  {% else %}
                    {{ property.last }}
                  {% endif %}
                </p>
              {% endif %}
            {% endfor %}
            {% if show_prices %}
              {% for discount_allocation in line_item.discount_allocations %}
                {% if discount_allocation.amount > 0 %}
                  <p class="items__meta"><span class="tag" style="--c:#e10b17">&#127991; {{ discount_allocation.discount_application.title | upcase }}</span> &minus;{{ discount_allocation.amount | money }}</p>
                {% endif %}
              {% endfor %}
            {% endif %}
          </td>
          {% if show_prices %}
            <td class="num">
              {% if unit_price != nil %}
                {% if line_item.original_price != nil and line_item.original_price > unit_price %}
                  <span class="was">{{ line_item.original_price | money }}</span><br>
                  <span class="now now--sale">{{ unit_price | money }}</span>
                {% elsif unit_price == 0 %}
                  <span class="tag" style="--c:#1fb85a">مجاني</span>
                {% else %}
                  <span class="now">{{ unit_price | money }}</span>
                {% endif %}
              {% endif %}
            </td>
          {% endif %}
          <td class="num">
            <span class="qty {% if qty_complete %}qty--full{% else %}qty--part{% endif %}">{{ line_item.shipping_quantity }}<small>/{{ line_item.quantity }}</small></span>
          </td>
          {% if show_prices %}
            <td class="num">
              {% if unit_price != nil %}
                {% assign shipped_total = unit_price | times: line_item.shipping_quantity %}
                {% if shipped_total == 0 %}<span class="green">مجاني</span>{% else %}<span class="now">{{ shipped_total | money }}</span>{% endif %}
              {% endif %}
            </td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {% unless includes_all_line_items_in_order %}
    {% unless is_pickup %}
      <div class="notice" style="--c:#ff6a00">
        <strong>تنبيه:</strong> باقي منتجات طلبك ستصلك في شحنة منفصلة.
      </div>
    {% endunless %}
  {% endunless %}

  {%- comment -%} ================= TOTALS (guarded) ================= {%- endcomment -%}
  {% if show_totals or show_prices %}
    <div class="totals-wrap">
      <div class="totals-note">
        {% if box_saved > 0 or order.total_discounts > 0 %}
          <div class="saved">
            <p class="saved__label">وفّرت</p>
            <p class="saved__amount">{% if order.total_discounts > 0 %}{{ order.total_discounts | money }}{% else %}{{ box_saved | money }}{% endif %}</p>
            {% for discount_application in order.discount_applications %}
              <span class="tag tag--light">&#127991; {{ discount_application.title | upcase }}</span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <table class="totals">
        {% if show_prices and includes_all_line_items_in_order == false %}
          <tr><td>هذا الصندوق</td><td class="num">{{ box_value | money }}</td></tr>
        {% endif %}
        {% if show_totals %}
          {% if order.subtotal_price != nil %}
            {% assign subtotal_before = order.subtotal_price | plus: order.total_discounts %}
            <tr><td>المجموع الفرعي</td><td class="num">{{ subtotal_before | money }}</td></tr>
          {% endif %}
          {% if order.total_discounts > 0 %}
            <tr class="totals__disc"><td>الخصومات</td><td class="num">&minus;{{ order.total_discounts | money }}</td></tr>
          {% endif %}
          {% if order.shipping_price != nil %}
            <tr><td>{% if is_pickup %}الاستلام{% else %}الشحن{% endif %}{% if order.shipping_method.title != blank %} <small>({{ order.shipping_method.title }})</small>{% endif %}</td><td class="num">{% if order.shipping_price == 0 %}<span class="green">مجاني</span>{% else %}{{ order.shipping_price | money }}{% endif %}</td></tr>
          {% endif %}
          {% if order.total_duties > 0 %}
            <tr><td>الرسوم الجمركية</td><td class="num">{{ order.total_duties | money }}</td></tr>
          {% endif %}
          {% if order.tax_price > 0 %}
            <tr><td>الضرائب</td><td class="num">{{ order.tax_price | money }}</td></tr>
          {% endif %}
          <tr class="totals__grand"><td>الإجمالي</td><td class="num">{{ order.total_price | money_with_currency }}</td></tr>
          {% if order.financial_status != blank %}
            <tr><td colspan="2" class="num">
              {% case order.financial_status %}
                {% when 'paid' %}<span class="tag" style="--c:#1fb85a">&#10003; مدفوع</span>
                {% when 'refunded', 'partially_refunded' %}<span class="tag" style="--c:#8b5cf6">{{ status_ar }}</span>
                {% else %}<span class="tag" style="--c:#ff6a00">{{ status_ar }}</span>
              {% endcase %}
            </td></tr>
          {% endif %}
        {% elsif show_prices %}
          <tr class="totals__grand"><td>إجمالي الصندوق</td><td class="num">{{ box_value | money }}</td></tr>
        {% endif %}
      </table>
    </div>
  {% endif %}

  {%- comment -%} ================= NOTES ================= {%- endcomment -%}
  {% if order.note != blank or delivery_method.instructions != blank %}
    <div class="notes">
      {% if order.note != blank %}
        <div class="sticky" style="--c:#ffd400">
          <p class="eyebrow">ملاحظة الطلب</p>
          <p>{{ order.note }}</p>
        </div>
      {% endif %}
      {% if delivery_method.instructions != blank %}
        <div class="sticky" style="--c:#2f6bff">
          <p class="eyebrow">تعليمات التوصيل</p>
          <p>{{ delivery_method.instructions }}</p>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%} ================= PACKING CHECK (staff) ================= {%- endcomment -%}
  <div class="check">
    <span><span class="box"></span> تم التجميع</span>
    <span><span class="box"></span> تم فحص الجودة</span>
    <span><span class="box"></span> تم التغليف</span>
    <span class="check__sign">غلّفه <i></i></span>
  </div>

  {%- comment -%} ================= THANK YOU / FOOTER ================= {%- endcomment -%}
  <div class="thanks">
    <div class="thanks__main">
      <p class="eyebrow eyebrow--yellow">من فريق 89</p>
      <p class="thanks__title">شكراً لك{% if customer.first_name != blank %}، <bdi>{{ customer.first_name }}</bdi>{% endif %}!</p>
      <p class="thanks__text">البسها بثقة! أشِر إلينا <strong dir="ltr">{{ brand_instagram }}</strong> على إنستغرام &mdash; ننشر أجمل الإطلالات.</p>
      <p class="thanks__text thanks__text--dim">المقاس غير مناسب أو في مشكلة؟ راسلنا ونحلّها لك بسرعة.</p>
    </div>
    <div class="thanks__qr">
      <img src="{{ brand_qr }}" alt="WhatsApp QR">
      <p>امسح للمحادثة<br><strong dir="ltr">{{ brand_whatsapp_display }}</strong></p>
    </div>
  </div>

  <div class="foot">
    <p class="foot__word" dir="ltr"><span class="red">89</span> Shirt Shop</p>
    <p class="foot__info">
      {% if shop_address.summary != blank %}{{ shop_address.summary }}<br>{% endif %}
      {{ shop.email }} &nbsp;&middot;&nbsp; {{ shop.domain }}
    </p>
  </div>
</div>

<style type="text/css">
  @page { size: A4; margin: 10mm; }
  * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; font-size: 14px; background: #ffffff; }
  p { margin: 0; }
  .red { color: #e10b17; }
  .green { color: #1fb85a; font-weight: 700; }

  .slip {
    width: 831px; max-width: 100%; margin: auto; padding: 0;
    font-family: 'Cairo', 'Kanit', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 400; color: #0a0a0a; line-height: 1.45;
  }
  .eyebrow { font-size: 10.5px; font-weight: 600; letter-spacing:0; text-transform: uppercase; color: #5c5c5c; }
  .eyebrow--red { color: #e10b17; }
  .eyebrow--yellow { color: #ffd400; }
  .eyebrow--c { color: var(--c); }

  /* header */
  .hdr { display: flex; justify-content: space-between; align-items: center; background: #0a0a0a; color: #fff; border-radius: 18px 18px 0 0; padding: 26px 30px; }
  .hdr__brand { display: flex; align-items: center; gap: 18px; }
  .hdr__logo { width: 64px; height: auto; display: block; }
  .hdr__title { font-weight: 900; font-size: 30px; line-height: 1; letter-spacing:0; text-transform: uppercase; margin-top: 4px; }
  .hdr__meta { text-align: right; }
  .hdr__order { display: inline-block; background: #e10b17; color: #fff; font-weight: 900; font-size: 22px; line-height: 1; padding: 10px 18px; border-radius: 999px; }
  .hdr__line { font-size: 12px; color: #b5b5b5; margin-top: 6px; }
  .stripe { display: flex; height: 7px; }
  .stripe span { flex: 1; }

  /* stats */
  .stats { display: flex; gap: 10px; margin: 18px 0 14px; }
  .stat { flex: 1; border-radius: 14px; padding: 14px 16px; background: color-mix(in srgb, var(--c) 10%, #fff); border: 2px solid var(--c); }
  .stat--solid { background: var(--c); color: #fff; }
  .stat__label { font-size: 10px; font-weight: 600; letter-spacing:0; text-transform: uppercase; color: var(--c); }
  .stat--solid .stat__label, .stat--solid .stat__sub { color: rgba(255,255,255,.85); }
  .stat__value { font-weight: 900; font-size: 34px; line-height: 1.05; margin-top: 4px; }
  .stat__value--sm { font-size: 20px; line-height: 1.25; }
  .stat__sub { font-size: 11.5px; color: #5c5c5c; margin-top: 2px; }

  /* cash on delivery */
  .cod { display: flex; justify-content: space-between; align-items: center; background: #ffd400; border: 2px dashed #0a0a0a; border-radius: 14px; padding: 14px 20px; margin-bottom: 14px; }
  .cod .eyebrow { color: #0a0a0a; }
  .cod__text { font-size: 13px; margin-top: 2px; }

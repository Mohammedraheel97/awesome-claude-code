{%- comment -%} NOTIFICATION: Local delivery: Delivered ('Order {{ name }} has been delivered') — ARABIC (paste in Translate & Adapt). Generated by tools/make_variants.py {%- endcomment -%}
{%- comment -%}
  ARABIC VERSION — generated by tools/make_arabic.py from shipping-confirmation.liquid.
  Paste into: Translate & Adapt > Arabic > Notifications > (this template) > Arabic field.
  Do NOT use Auto-translate on this template; it would translate the Liquid code.
{%- endcomment -%}
{%- comment -%}
  89 SHIRT SHOP — fulfillment notification (base template: Shipping confirmation)
  Paste into: Shopify admin > Settings > Notifications > Customer notifications > [the matching notification] > Edit code
  Brand tokens match order-confirmation.liquid (ink #0a0a0a · red #e10b17 · bone #f3f2ef · Kanit / Cairo).
{%- endcomment -%}
{%- assign brand_logo = 'https://cdn.shopify.com/s/files/1/0785/2956/0650/files/89shirt-email-logo-white.png?v=1793723695' -%}
{%- assign brand_whatsapp = '96566899260' -%}
{%- assign brand_instagram = 'https://www.instagram.com/89shirt' -%}
{%- assign c_ink = '#0a0a0a' -%}
{%- assign c_ink2 = '#121212' -%}
{%- assign c_red = '#e10b17' -%}
{%- assign c_bone = '#f3f2ef' -%}
{%- assign c_smoke = '#e6e5e2' -%}
{%- assign c_gray = '#8a8a8a' -%}
{%- assign c_gray_dark = '#5c5c5c' -%}
{%- assign c_green = '#1fb85a' -%}

{% assign buyer_email_rtl = true %}
{%- if buyer_email_rtl -%}
  {%- assign a_start = 'right' -%}{%- assign a_end = 'left' -%}
  {%- assign f_display = "'Cairo','Kanit','Arial Black',Arial,sans-serif" -%}
  {%- assign f_body = "'Cairo','Kanit','Helvetica Neue',Arial,sans-serif" -%}
  {%- capture bo -%}&rlm;&lrm;<span dir="auto" style="display:inline-block;unicode-bidi:isolate;font-size:inherit;">{%- endcapture -%}
  {%- capture bc -%}</span>&lrm;&rlm;{%- endcapture -%}
  {%- capture lo -%}<span dir="ltr" style="display:inline-block;unicode-bidi:isolate;font-size:inherit;">{%- endcapture -%}
  {%- capture lc -%}</span>{%- endcapture -%}
{%- else -%}
  {%- assign a_start = 'left' -%}{%- assign a_end = 'right' -%}
  {%- assign f_display = "'Kanit','Cairo','Arial Black','Helvetica Neue',Arial,sans-serif" -%}
  {%- assign f_body = "'Kanit','Cairo','Helvetica Neue',Arial,sans-serif" -%}
  {%- assign bo = '' -%}{%- assign bc = '' -%}{%- assign lo = '' -%}{%- assign lc = '' -%}
{%- endif -%}

{%- comment -%}
  STAGE — this one base powers 5 notifications. tools/make_variants.py rewrites these two lines:
    shipping-confirmation      stage 'shipped'           is_local false
    shipping-out-for-delivery  stage 'out_for_delivery'  is_local false
    shipping-delivered         stage 'delivered'         is_local false
    local-out-for-delivery     stage 'out_for_delivery'  is_local true
    local-delivered            stage 'delivered'         is_local true
{%- endcomment -%}
{%- assign stage = 'delivered' -%}
{%- assign is_local = true -%}

{%- comment -%} ---- wording per stage ---- {%- endcomment -%}
{%- case stage -%}
  {%- when 'out_for_delivery' -%}
    {%- capture s_is -%}خرج للتوصيل{%- endcapture -%}
    {%- capture s_are -%}خرجت للتوصيل{%- endcapture -%}
    {%- capture hero_full -%}خرجت للتوصيل.{%- endcapture -%}
    {%- capture tail_s -%}خرج للتوصيل.{%- endcapture -%}
    {%- capture tail_p -%}خرجت للتوصيل.{%- endcapture -%}
    {%- capture body_tail -%}تتبّع شحنتك لمعرفة حالة التوصيل.{%- endcapture -%}
    {%- capture eyebrow -%}خرج للتوصيل{%- endcapture -%}
  {%- when 'delivered' -%}
    {%- capture s_is -%}وصل{%- endcapture -%}
    {%- capture s_are -%}وصلت{%- endcapture -%}
    {%- capture hero_full -%}وصلت!{%- endcapture -%}
    {%- capture tail_s -%}وصل!{%- endcapture -%}
    {%- capture tail_p -%}وصلت!{%- endcapture -%}
    {%- capture body_tail -%}استمتع بإطلالتك الجديدة — وأشِر إلينا على <span dir="ltr">@89shirt</span> عندما تلبسها.{%- endcapture -%}
    {%- capture eyebrow -%}تم التوصيل{%- endcapture -%}
  {%- else -%}
    {%- capture s_is -%}في الطريق إليك{%- endcapture -%}
    {%- capture s_are -%}في الطريق إليك{%- endcapture -%}
    {%- capture hero_full -%}في الطريق إليك.{%- endcapture -%}
    {%- capture tail_s -%}في الطريق إليك.{%- endcapture -%}
    {%- capture tail_p -%}في الطريق إليك.{%- endcapture -%}
    {%- capture body_tail -%}تتبّع شحنتك لمعرفة حالة التوصيل.{%- endcapture -%}
    {%- capture eyebrow -%}تم الشحن{%- endcapture -%}
{%- endcase -%}

{% if is_local %}
  {% capture email_title %}طلبك {{ s_is }}{% endcapture %}
  {% capture hero_1 %}إطلالتك{% endcapture %}{% capture hero_2 %}{{ hero_full }}{% endcapture %}
  {% if stage == 'delivered' %}
    {% capture email_body %}طلبك {{ s_is }}. {{ body_tail }}{% endcapture %}
  {% else %}
    {% capture email_body %}طلبك في الطريق وسيصلك قريباً.{% endcapture %}
  {% endif %}
{% elsif fulfillment.item_count == item_count %}
  {% capture email_title %}طلبك {{ s_is }}{% endcapture %}
  {% capture hero_1 %}إطلالتك{% endcapture %}{% capture hero_2 %}{{ hero_full }}{% endcapture %}
  {% capture email_body %}طلبك {{ s_is }}. {{ body_tail }}{% endcapture %}
{% elsif fulfillment.item_count > 1 %}
  {% if fulfillment_status == 'fulfilled' %}
    {% capture email_title %}آخر منتجات طلبك {{ s_are }}{% endcapture %}
    {% capture hero_1 %}آخر المنتجات{% endcapture %}{% capture hero_2 %}{{ tail_p }}{% endcapture %}
    {% capture email_body %}آخر منتجات طلبك {{ s_are }}. {{ body_tail }}{% endcapture %}
  {% else %}
    {% capture email_title %}بعض منتجات طلبك {{ s_are }}{% endcapture %}
    {% capture hero_1 %}بعض المنتجات{% endcapture %}{% capture hero_2 %}{{ tail_p }}{% endcapture %}
    {% capture email_body %}بعض منتجات طلبك {{ s_are }}. {{ body_tail }}{% endcapture %}
  {% endif %}
{% else %}
  {% if fulfillment_status == 'fulfilled' %}
    {% capture email_title %}آخر منتج في طلبك {{ s_is }}{% endcapture %}
    {% capture hero_1 %}آخر منتج{% endcapture %}{% capture hero_2 %}{{ tail_s }}{% endcapture %}
    {% capture email_body %}آخر منتج في طلبك {{ s_is }}. {{ body_tail }}{% endcapture %}
  {% else %}
    {% capture email_title %}منتج من طلبك {{ s_is }}{% endcapture %}
    {% capture hero_1 %}منتج واحد{% endcapture %}{% capture hero_2 %}{{ tail_s }}{% endcapture %}
    {% capture email_body %}منتج من طلبك {{ s_is }}. {{ body_tail }}{% endcapture %}
  {% endif %}
{% endif %}

{%- liquid
  # tracker: which step is current, and the step names
  case stage
    when 'out_for_delivery'
      assign active_step = 3
      assign bar_pct = 74
    when 'delivered'
      assign active_step = 4
      assign bar_pct = 100
    else
      assign active_step = 2
      assign bar_pct = 44
  endcase
  if is_local
    assign step_labels = 'تم الطلب|تم التغليف|خرج للتوصيل|تم التوصيل' | split: '|'
  else
    assign step_labels = 'تم الطلب|تم الشحن|خرج للتوصيل|تم التوصيل' | split: '|'
  endif
  assign show_eta = false
  if fulfillment.estimated_delivery_at and stage != 'delivered'
    assign show_eta = true
  endif
  assign stage_color = c_red
  if stage == 'delivered'
    assign stage_color = c_green
  endif

  assign primary_track_url = nil
  if stage == 'delivered'
    # no "track" button once it has arrived
  elsif fulfillment.tracking_url != blank
    assign primary_track_url = fulfillment.tracking_url
  elsif fulfillment.tracking_urls.size > 0
    assign primary_track_url = fulfillment.tracking_urls.first
  endif
  assign shipped_units = 0
  for line in fulfillment.fulfillment_line_items
    assign shipped_units = shipped_units | plus: line.quantity
  endfor
-%}

<!DOCTYPE html>
<html lang="ar"{% if buyer_email_rtl %} dir="rtl"{% endif %} xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;900&family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
  <!--[if mso]><style>* { font-family: Arial, sans-serif !important; }</style><![endif]-->
  <style>
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; background: {{ c_bone }}; }
    a { color: {{ c_red }}; }
    .x-btn:hover { background: #b4060f !important; }
    .x-address p, .x-address { margin: 0; }
    @media only screen and (max-width: 620px) {
      .x-wrap { width: 100% !important; }
      .x-pad { padding-left: 20px !important; padding-right: 20px !important; }
      .x-hero { font-size: 38px !important; line-height: 54px !important; }
      .x-stack { display: block !important; width: 100% !important; box-sizing: border-box !important; }
      .x-stack-gap { padding-top: 0 !important; text-align: {{ a_start }} !important; white-space: normal !important; }
      .x-btn-full { width: 100% !important; }
      .x-wordmark { font-size: 34px !important; line-height: 44px !important; }
      .x-step-label { font-size: 10px !important; }
    }
  </style>
</head>

<body style="margin:0;padding:0;background:{{ c_bone }};">
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:{{ c_bone }};opacity:0;">
    {{ email_title }} &mdash; الطلب {{ order_name }}{% if show_eta %}، يصل في {{ fulfillment.estimated_delivery_at | date: format: 'date' }}{% endif %}.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ c_bone }};"{% if buyer_email_rtl %} dir="rtl"{% endif %}>
    <tr>
      <td align="center" style="padding:24px 12px 40px;">
        <table role="presentation" class="x-wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;"{% if buyer_email_rtl %} dir="rtl"{% endif %}>

          {%- comment -%} ============ HEADER + HERO ============ {%- endcomment -%}
          <tr>
            <td style="background:{{ c_ink }};border-radius:14px 14px 0 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="x-pad" style="padding:28px 36px 0;text-align:{{ a_start }};" valign="middle">
                    <a href="{{ shop.url }}" style="text-decoration:none;"><img src="{{ brand_logo }}" width="64" height="59" alt="{{ shop.name }}" style="display:block;width:64px;height:auto;border:0;"></a>
                  </td>
                  <td class="x-pad" style="padding:28px 36px 0;text-align:{{ a_end }};" valign="middle">
                    <span style="display:inline-block;border:1px solid #2a2a2a;border-radius:999px;padding:8px 16px;font-family:{{ f_body }};font-size:12px;line-height:14px;letter-spacing:0;text-transform:uppercase;color:{{ c_gray }};">
                      طلب&nbsp;<span style="color:#ffffff;font-weight:700;">{{ lo }}{{ order_name }}{{ lc }}</span>
                    </span>
                    {%- if po_number %}
                      <div style="padding-top:8px;font-family:{{ f_body }};font-size:12px;line-height:16px;color:{{ c_gray }};">رقم أمر الشراء {{ lo }}#{{ po_number }}{{ lc }}</div>
                    {%- endif %}
                  </td>
                </tr>
                <tr>
                  <td colspan="2" class="x-pad" style="padding:44px 36px 0;text-align:{{ a_start }};">
                    <div style="font-family:{{ f_body }};font-size:12px;line-height:14px;font-weight:600;letter-spacing:0;text-transform:uppercase;color:{{ stage_color }};">
                      &#9679;&nbsp;{{ eyebrow }}
                    </div>
                    <h1 class="x-hero" style="margin:12px 0 0;font-family:{{ f_display }};font-size:48px;line-height:66px;font-weight:900;letter-spacing:0;color:#ffffff;text-transform:uppercase;">
                      {{ hero_1 }}<br><span style="color:{{ stage_color }};">{{ hero_2 }}</span>
                    </h1>
                    <div style="margin:20px 0 0;font-family:{{ f_body }};font-size:16px;line-height:26px;color:#cfcfcf;max-width:460px;">
                      {% if customer.first_name != blank %}مرحباً {{ bo }}{{ customer.first_name }}{{ bc }}! {% endif %}{{ email_body }}
                    </div>
                    {% if stage == 'delivered' %}
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:18px;border:1px solid #2a2a2a;border-radius:12px;background:{{ c_ink2 }};">
                        <tr>
                          <td style="padding:12px 16px;font-family:{{ f_body }};font-size:14px;line-height:20px;color:#cfcfcf;text-align:{{ a_start }};">
                            <span style="color:#ffd400;font-weight:700;">?</span>&nbsp; لم تصلك شحنتك بعد؟
                            <a href="https://wa.me/{{ brand_whatsapp }}?text={{ 'مرحباً 89، لم يصلني الطلب ' | append: order_name | url_encode }}" style="color:#ffffff;font-weight:600;text-decoration:underline;">أخبرنا</a>
                          </td>
                        </tr>
                      </table>
                    {% endif %}
                  </td>
                </tr>

                {%- comment -%} ---- progress tracker ---- {%- endcomment -%}
                <tr>
                  <td colspan="2" class="x-pad" style="padding:30px 36px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ c_ink2 }};border:1px solid #2a2a2a;border-radius:14px;">
                      <tr>
                        <td style="padding:18px 16px 16px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              {% for label in step_labels %}
                                {%- liquid
                                  assign idx = forloop.index
                                  assign state = 'todo'
                                  if idx < active_step or stage == 'delivered'
                                    assign state = 'done'
                                  endif
                                  if idx == active_step and stage != 'delivered'
                                    assign state = 'now'
                                  endif
                                -%}
                                <td width="25%" align="center" valign="top" style="width:25%;">
                                  {% if state == 'done' %}
                                    <div style="width:30px;height:30px;line-height:30px;border-radius:999px;background:{{ c_green }};color:#ffffff;font-family:{{ f_body }};font-size:15px;font-weight:700;margin:0 auto;{% if idx == active_step %}box-shadow:0 0 0 5px rgba(31,184,90,.25);{% endif %}">&#10003;</div>
                                    <div class="x-step-label" style="padding-top:8px;font-family:{{ f_body }};font-size:12px;line-height:16px;font-weight:{% if idx == active_step %}700{% else %}600{% endif %};color:{% if idx == active_step %}{{ c_green }}{% else %}#ffffff{% endif %};">{{ label }}</div>
                                  {% elsif state == 'now' %}
                                    <div style="width:30px;height:30px;line-height:30px;border-radius:999px;background:{{ c_red }};color:#ffffff;font-family:{{ f_body }};font-size:15px;font-weight:700;margin:0 auto;box-shadow:0 0 0 5px rgba(225,11,23,.25);">&#10148;</div>
                                    <div class="x-step-label" style="padding-top:8px;font-family:{{ f_body }};font-size:12px;line-height:16px;font-weight:700;color:{{ c_red }};">{{ label }}</div>
                                  {% else %}
                                    <div style="width:30px;height:30px;line-height:30px;border-radius:999px;background:#2a2a2a;color:{{ c_gray }};font-family:{{ f_body }};font-size:13px;font-weight:700;margin:0 auto;">{{ idx }}</div>
                                    <div class="x-step-label" style="padding-top:8px;font-family:{{ f_body }};font-size:12px;line-height:16px;font-weight:600;color:{{ c_gray }};">{{ label }}</div>
                                  {% endif %}
                                </td>
                              {% endfor %}
                            </tr>
                            <tr>
                              <td colspan="4" style="padding:14px 0 0;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-radius:999px;background:#2a2a2a;">
                                  <tr>
                                    <td width="{{ bar_pct }}%" height="6" style="width:{{ bar_pct }}%;height:6px;line-height:6px;font-size:0;background:{{ stage_color }};border-radius:999px;">&nbsp;</td>
                                    {% if bar_pct < 100 %}<td width="{{ 100 | minus: bar_pct }}%" height="6" style="width:{{ 100 | minus: bar_pct }}%;height:6px;line-height:6px;font-size:0;">&nbsp;</td>{% endif %}
                                  </tr>
                                </table>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                {%- comment -%} ---- estimated delivery + tracking ---- {%- endcomment -%}
                {% if show_eta or fulfillment.tracking_numbers.size > 0 %}
                  <tr>
                    <td colspan="2" class="x-pad" style="padding:12px 36px 0;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          {% if show_eta %}
                            <td class="x-stack" valign="top" style="background:{{ c_red }};border-radius:14px;padding:16px 18px;text-align:{{ a_start }};{% if fulfillment.tracking_numbers.size > 0 %}width:46%;{% endif %}">
                              <div style="font-family:{{ f_body }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:0;text-transform:uppercase;color:rgba(255,255,255,.85);">موعد التوصيل المتوقع</div>
                              <div style="padding-top:6px;font-family:{{ f_display }};font-size:22px;line-height:26px;font-weight:900;color:#ffffff;">{{ bo }}{{ fulfillment.estimated_delivery_at | date: format: 'date' }}{{ bc }}</div>
                            </td>
                            {% if fulfillment.tracking_numbers.size > 0 %}<td class="x-stack" width="12" style="width:12px;height:12px;font-size:0;line-height:0;">&nbsp;</td>{% endif %}
                          {% endif %}
                          {% if fulfillment.tracking_numbers.size > 0 %}
                            <td class="x-stack" valign="top" style="background:{{ c_ink2 }};border:1px solid #2a2a2a;border-radius:14px;padding:16px 18px;text-align:{{ a_start }};">
                              <div style="font-family:{{ f_body }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:0;text-transform:uppercase;color:{{ c_gray }};">
                                {% if fulfillment.tracking_company %}{{ bo }}{{ fulfillment.tracking_company }}{{ bc }} &middot; {% endif %}{% if fulfillment.tracking_numbers.size == 1 %}رقم التتبع{% else %}أرقام التتبع{% endif %}
                              </div>
                              {% for tracking_number in fulfillment.tracking_numbers %}
                                {% assign t_url = fulfillment.tracking_urls[forloop.index0] %}
                                {% if fulfillment.tracking_numbers.size == 1 and fulfillment.tracking_url %}{% assign t_url = fulfillment.tracking_url %}{% endif %}
                                <div style="padding-top:6px;font-family:{{ f_body }};font-size:16px;line-height:22px;font-weight:700;color:#ffffff;">
                                  {% if t_url %}<a href="{{ t_url }}" style="color:#ffffff;text-decoration:underline;">{{ lo }}{{ tracking_number }}{{ lc }}</a>{% else %}{{ lo }}{{ tracking_number }}{{ lc }}{% endif %}
                                </div>
                              {% endfor %}
                            </td>
                          {% endif %}
                        </tr>
                      </table>
                    </td>
                  </tr>
                {% endif %}

                {%- comment -%} ---- buttons ---- {%- endcomment -%}
                <tr>
                  <td colspan="2" class="x-pad" style="padding:28px 36px 40px;text-align:{{ a_start }};">
                    {% if primary_track_url %}
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="x-btn-full" style="display:inline-table;">
                        <tr>
                          <td class="x-btn" align="center" bgcolor="{{ c_red }}" style="background:{{ c_red }};border-radius:999px;">
                            <a href="{{ primary_track_url }}" style="display:inline-block;padding:17px 34px;font-family:{{ f_body }};font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:999px;">تتبّع شحنتك&nbsp;&larr;</a>
                          </td>
                        </tr>
                      </table>
                    {% elsif order_status_url %}
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="x-btn-full" style="display:inline-table;">
                        <tr>
                          <td class="x-btn" align="center" bgcolor="{{ c_red }}" style="background:{{ c_red }};border-radius:999px;">
                            <a href="{{ order_status_url }}" style="display:inline-block;padding:17px 34px;font-family:{{ f_body }};font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:999px;">عرض طلبك&nbsp;&larr;</a>
                          </td>
                        </tr>
                      </table>
                    {% endif %}

                    {% if order_status_url and shop_app_tracking_url and shop_app_tracking_button_variant_key %}
                      {% capture shop_logo_img %}<img src="{{ 'mailer/shop_logo.png' | cdn_asset_url }}" alt="Shop" width="42" height="17" style="vertical-align:middle;border:0;">{% endcapture %}
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="x-btn-full" style="display:inline-table;margin-top:12px;">
                        <tr>
                          <td align="center" bgcolor="#5a31f4" style="background:#5a31f4;border-radius:999px;">
                            <a href="{{ shop_app_tracking_url }}" style="display:inline-block;padding:15px 28px;font-family:{{ f_body }};font-size:15px;line-height:22px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:999px;">
                              {% if shop_app_tracking_button_variant_key == "track_with_shop" %}تتبّع الطلب عبر{% else %}حمّل التطبيق للتتبّع عبر{% endif %} {{ shop_logo_img }}
                            </a>
                          </td>
                        </tr>
                      </table>
                    {% endif %}

                    <div style="padding-top:18px;font-family:{{ f_body }};font-size:14px;line-height:20px;color:{{ c_gray }};">
                      {% if primary_track_url and order_status_url %}
                        <a href="{{ order_status_url }}" style="color:#ffffff;font-weight:600;text-decoration:underline;">عرض طلبك</a>{% if shop.url %} &nbsp;&middot;&nbsp; {% endif %}
                      {% elsif shop.url %}أو {% endif %}
                      {% if shop.url %}<a href="{{ shop.url }}" style="color:#ffffff;font-weight:600;text-decoration:underline;">زُر متجرنا</a>{% endif %}
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr><td height="6" style="height:6px;line-height:6px;font-size:0;background:{{ c_red }};">&nbsp;</td></tr>

          {%- comment -%} ============ ITEMS IN THIS SHIPMENT ============ {%- endcomment -%}
          <tr>
            <td class="x-pad" style="background:#ffffff;padding:36px 36px 12px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="text-align:{{ a_start }};">
                    <div style="font-family:{{ f_body }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:0;text-transform:uppercase;color:{{ c_red }};">داخل الصندوق</div>
                    <h2 style="margin:6px 0 0;font-family:{{ f_display }};font-size:26px;line-height:38px;font-weight:900;letter-spacing:0;text-transform:uppercase;color:{{ c_ink }};">{% if is_local %}المنتجات في هذا التوصيل{% else %}المنتجات في هذه الشحنة{% endif %}</h2>
                  </td>
                  <td valign="bottom" style="text-align:{{ a_end }};white-space:nowrap;">
                    <span style="display:inline-block;background:{{ c_ink }};color:#ffffff;border-radius:999px;padding:5px 12px;font-family:{{ f_body }};font-size:12px;line-height:16px;font-weight:600;">{{ lo }}{{ shipped_units }}{{ lc }} قطعة</span>
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;">
                {% for line in fulfillment.fulfillment_line_items %}
                  {% if line.line_item.nested_line_child? %}{% continue %}{% endif %}
                  {%- liquid
                    assign li = line.line_item
                    if li.presentment_title
                      assign line_title = li.presentment_title
                    elsif li.title
                      assign line_title = li.title
                    else
                      assign line_title = li.product.title
                    endif
                    assign is_partial_line = false
                    if line.quantity < li.quantity
                      assign is_partial_line = true
                    endif
                  -%}
                  <tr>
                    <td width="76" valign="top" style="width:76px;padding:16px 0;border-bottom:1px solid {{ c_smoke }};">
                      {% if li.image %}
                        <img src="{{ li | img_url: 'compact_cropped' }}" width="64" height="64" alt="" style="display:block;width:64px;height:64px;border-radius:10px;background:{{ c_bone }};">
                      {% else %}
                        <table role="presentation" width="64" height="64" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" style="width:64px;height:64px;background:{{ c_bone }};border-radius:10px;"><img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="28" height="28" alt="" style="display:block;"></td></tr></table>
                      {% endif %}
                    </td>
                    <td valign="top" style="padding:16px 12px;border-bottom:1px solid {{ c_smoke }};font-family:{{ f_body }};text-align:{{ a_start }};">
                      <div style="font-size:15px;line-height:21px;font-weight:600;color:{{ c_ink }};">{{ bo }}{{ line_title }}{{ bc }}</div>
                      <div style="padding-top:4px;font-size:13px;line-height:19px;color:{{ c_gray_dark }};">
                        {% if li.variant.title != 'Default Title' %}{{ bo }}{{ li.variant.title }}{{ bc }}{% endif %}
                      </div>
                      {% if li.selling_plan_allocation %}
                        <div style="padding-top:2px;font-size:13px;line-height:19px;color:{{ c_gray_dark }};">{{ bo }}{{ li.selling_plan_allocation.selling_plan.name }}{{ bc }}</div>
                      {% endif %}

                      {% for child_line in li.bundle_components %}
                        {% if forloop.first %}<div style="padding-top:8px;">{% endif %}
                        <div style="font-size:12px;line-height:18px;color:{{ c_gray_dark }};">
                          {{ lo }}{{ child_line.quantity }}{{ lc }}&nbsp;&times;&nbsp;{{ bo }}{{ child_line.product.title | default: child_line.title }}{{ bc }}{% if child_line.variant.title != 'Default Title' %} &middot; {{ bo }}{{ child_line.variant.title }}{{ bc }}{% endif %}{% if child_line.selling_plan_allocation and li.selling_plan_allocation == nil %} &middot; {{ bo }}{{ child_line.selling_plan_allocation.selling_plan.name }}{{ bc }}{% endif %}
                        </div>
                        {% if forloop.last %}</div>{% endif %}
                      {% endfor %}

                      {% if li.nested_line_parent? %}
                        {% for child_line in li.nested_lines %}
                          {% if forloop.first %}<div style="margin-top:6px;padding-top:2px;border-{{ a_start }}:2px solid {{ c_smoke }};padding-{{ a_start }}:10px;">{% endif %}
                          <div style="font-size:12px;line-height:18px;color:{{ c_gray_dark }};">
                            + {{ bo }}{{ child_line.product.title | default: child_line.title }}{{ bc }}&nbsp;&times;&nbsp;{{ lo }}{{ child_line.quantity }}{{ lc }}{% if child_line.variant.title != 'Default Title' %} &middot; {{ bo }}{{ child_line.variant.title }}{{ bc }}{% endif %}{% if child_line.selling_plan_allocation %} &middot; {{ bo }}{{ child_line.selling_plan_allocation.selling_plan.name }}{{ bc }}{% endif %}
                          </div>
                          {% if forloop.last %}</div>{% endif %}
                        {% endfor %}
                      {% endif %}

                      {% unless li.bundle_components.size > 0 %}
                        {% for group in li.groups %}
                          <div style="padding-top:4px;font-size:12px;line-height:18px;color:{{ c_gray_dark }};">
                            {% if group.deliverable? %}لـ: {% else %}جزء من: {% endif %}{{ bo }}{{ group.display_title }}{{ bc }}
                          </div>
                        {% endfor %}
                      {% endunless %}

                      {% if li.refunded_quantity > 0 %}
                        <div style="padding-top:6px;"><span style="display:inline-block;background:{{ c_bone }};color:{{ c_gray_dark }};border-radius:999px;padding:2px 10px;font-size:11px;font-weight:600;letter-spacing:0;text-transform:uppercase;">مسترد</span></div>
                      {% endif %}

                      {% for discount_allocation in li.discount_allocations %}
                        {% if discount_allocation.discount_application.target_selection != 'all' %}
                          <div style="padding-top:6px;font-size:12px;line-height:18px;font-weight:600;letter-spacing:0;color:{{ c_red }};">
                            <img src="{{ 'notifications/discounttag.png' | shopify_asset_url }}" width="14" height="14" alt="" style="vertical-align:-2px;border:0;">
                            {{ bo }}{{ discount_allocation.discount_application.title | upcase }}{{ bc }} {{ bo }}(-{{ discount_allocation.amount | money }}){{ bc }}
                          </div>
                        {% endif %}
                      {% endfor %}
                    </td>
                    <td valign="top" style="padding:16px 0;border-bottom:1px solid {{ c_smoke }};font-family:{{ f_body }};text-align:{{ a_end }};white-space:nowrap;">
                      <span style="display:inline-block;background:{% if is_partial_line %}#ff6a00{% else %}{{ c_ink }}{% endif %};color:#ffffff;border-radius:999px;padding:4px 11px;font-size:13px;line-height:18px;font-weight:700;">
                        &times;&nbsp;{{ lo }}{{ line.quantity }}{{ lc }}{% if is_partial_line %}<span style="font-weight:400;opacity:.85;"> من {{ lo }}{{ li.quantity }}{{ lc }}</span>{% endif %}
                      </span>
                    </td>
                  </tr>
                {% endfor %}
              </table>
            </td>
          </tr>

          {%- comment -%} ============ SHIPPING TO ============ {%- endcomment -%}
          {% if shipping_address %}
            <tr>
              <td class="x-pad" style="background:#ffffff;padding:20px 36px 36px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ c_bone }};border-radius:14px;">
                  <tr>
                    <td class="x-stack" valign="top" style="padding:22px 24px;text-align:{{ a_start }};">
                      <div style="margin:0 0 6px;font-family:{{ f_body }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:0;text-transform:uppercase;color:{{ c_red }};">{% if stage == 'delivered' %}تم التوصيل إلى{% elsif is_local %}التوصيل إلى{% else %}الشحن إلى{% endif %}</div>
                      <div class="x-address" style="font-family:{{ f_body }};font-size:14px;line-height:21px;color:{{ c_ink }};"{% if buyer_email_rtl %} dir="auto"{% endif %}>{{ shipping_address | format_address }}</div>
                    </td>
                    {% if shipping_method %}
                      <td class="x-stack" valign="top" style="padding:22px 24px;text-align:{{ a_start }};">
                        <div style="margin:0 0 6px;font-family:{{ f_body }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:0;text-transform:uppercase;color:{{ c_red }};">طريقة الشحن</div>
                        <div style="font-family:{{ f_body }};font-size:14px;line-height:21px;color:{{ c_ink }};">{{ bo }}{{ shipping_method.title }}{{ bc }}</div>
                      </td>
                    {% endif %}
                  </tr>
                </table>
              </td>
            </tr>
          {% else %}
            <tr><td style="background:#ffffff;height:24px;line-height:24px;font-size:0;">&nbsp;</td></tr>
          {% endif %}

          {%- comment -%} ============ DELIVERED: TAG US ============ {%- endcomment -%}
          {% if stage == 'delivered' %}
            <tr>
              <td class="x-pad" style="background:#ffffff;padding:0 36px 16px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ c_red }};border-radius:14px;">
                  <tr>
                    <td class="x-stack" valign="middle" style="padding:22px 24px;text-align:{{ a_start }};">
                      <div style="font-family:{{ f_display }};font-size:24px;line-height:34px;font-weight:900;text-transform:uppercase;color:#ffffff;">البسها. صوّرها.</div>
                      <div style="padding-top:6px;font-family:{{ f_body }};font-size:14px;line-height:20px;color:rgba(255,255,255,.9);">انشر إطلالتك وأشِر إلى <b dir="ltr">@89shirt</b> &mdash; ننشر أجمل الإطلالات.</div>
                    </td>
                    <td class="x-stack x-stack-gap" valign="middle" align="{{ a_end }}" style="padding:22px 24px;text-align:{{ a_end }};white-space:nowrap;">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="display:inline-table;">
                        <tr>
                          <td align="center" bgcolor="#ffffff" style="background:#ffffff;border-radius:999px;">
                            <a href="{{ brand_instagram }}" style="display:inline-block;padding:13px 24px;font-family:{{ f_body }};font-size:14px;line-height:18px;font-weight:700;color:{{ c_red }};text-decoration:none;border-radius:999px;">افتح إنستغرام</a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          {% endif %}

          {%- comment -%} ============ HELP STRIP ============ {%- endcomment -%}
          <tr>
            <td class="x-pad" style="background:#ffffff;padding:0 36px 36px;border-radius:0 0 14px 14px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:2px solid {{ c_ink }};border-radius:14px;">
                <tr>
                  <td class="x-stack" valign="middle" style="padding:20px 22px;font-family:{{ f_body }};text-align:{{ a_start }};">
                    <div style="font-family:{{ f_display }};font-size:18px;line-height:22px;font-weight:900;text-transform:uppercase;color:{{ c_ink }};">عندك سؤال؟</div>
                    <div style="padding-top:4px;font-size:14px;line-height:20px;color:{{ c_gray_dark }};">رد على هذه الرسالة أو راسلنا على واتساب — نرد بسرعة.</div>
                  </td>
                  <td class="x-stack x-stack-gap" valign="middle" align="{{ a_end }}" style="padding:20px 22px;text-align:{{ a_end }};white-space:nowrap;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="display:inline-table;">
                      <tr>
                        <td align="center" bgcolor="{{ c_ink }}" style="background:{{ c_ink }};border-radius:999px;">
                          <a href="https://wa.me/{{ brand_whatsapp }}?text={{ 'مرحباً 89، بخصوص طلبي ' | append: order_name | url_encode }}" style="display:inline-block;padding:13px 24px;font-family:{{ f_body }};font-size:14px;line-height:18px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:999px;">راسلنا على واتساب</a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {%- comment -%} ============ FOOTER ============ {%- endcomment -%}
          <tr><td height="14" style="height:14px;line-height:14px;font-size:0;">&nbsp;</td></tr>
          <tr>
            <td class="x-pad" style="background:{{ c_ink }};border-radius:14px;padding:34px 36px 30px;text-align:{{ a_start }};">
              <div class="x-wordmark" dir="ltr" style="text-align:right;font-family:{{ f_display }};font-size:46px;line-height:56px;font-weight:900;letter-spacing:0;text-transform:uppercase;color:#ffffff;">
                <span style="color:{{ c_red }};">89</span> Shirt Shop
              </div>
              <div style="padding-top:18px;font-family:{{ f_body }};font-size:13px;line-height:20px;">
                <a href="{{ shop.url }}" style="color:#ffffff;text-decoration:none;font-weight:600;">المتجر</a>
                <span style="color:#3a3a3a;">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
                <a href="{{ brand_instagram }}" style="color:#ffffff;text-decoration:none;font-weight:600;">إنستغرام</a>
                <span style="color:#3a3a3a;">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
                <a href="https://wa.me/{{ brand_whatsapp }}" style="color:#ffffff;text-decoration:none;font-weight:600;">واتساب</a>
              </div>
              <p style="margin:18px 0 0;font-family:{{ f_body }};font-size:12px;line-height:19px;color:{{ c_gray }};">
                إذا كان لديك أي استفسار، رد على هذه الرسالة أو تواصل معنا على <a href="mailto:{{ shop.email }}" style="color:#ffffff;">{{ lo }}{{ shop.email }}{{ lc }}</a>.<!-- shopify-managed-taxes-footer -->
              </p>
              <p style="margin:8px 0 0;font-family:{{ f_body }};font-size:11px;line-height:16px;color:{{ c_gray_dark }};">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
            </td>
          </tr>
        </table>
        <img src="{{ 'notifications/spacer.png' | shopify_asset_url }}" height="1" width="1" alt="" style="display:block;">
      </td>
    </tr>
  </table>
</body>
</html>
